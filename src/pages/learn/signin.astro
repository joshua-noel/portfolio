---
import Learn from "../../layouts/Learn.astro";
import { learnCookieName } from "../../lib/auth.ts";
import { getConfig } from "../../lib/config.ts";
import { getDb, now } from "../../lib/db.ts";
import { signIn } from "../../lib/learn-signin.ts";
import { safeNext } from "../../lib/users.ts";
import { clientIp } from "../../lib/routing.ts";

const config = getConfig();
const viewer = Astro.locals.viewer;

/** A username, a password and a path; anything bigger is not a sign-in. */
const MAX_BODY_BYTES = 4096;

if (Astro.request.method === "POST") {
  // Both checks run before formData(), which buffers the whole body. A missing
  // Content-Length counts as too large: browsers always send one.
  const length = Number(Astro.request.headers.get("content-length") ?? Infinity);
  if (!(length <= MAX_BODY_BYTES)) return new Response("Too large", { status: 413 });

  const form = await Astro.request.formData();
  const next = safeNext(form.get("next"), Astro.url);
  const result = await signIn({
    handle: getDb(),
    now: now(),
    bootstrap: { username: config.adminUsername, passwordHash: config.adminPasswordHash },
    ip: clientIp(
      Astro.clientAddress,
      Astro.request.headers.get("x-forwarded-for"),
      config.trustedProxies,
      config.trustedProxyHops,
    ),
    username: form.get("username"),
    password: form.get("password"),
    oldToken: Astro.cookies.get(learnCookieName(Astro.url))?.value,
  });

  if (result.kind === "locked")
    return Astro.redirect(`/signin?next=${encodeURIComponent(next)}&locked`, 303);
  if (result.kind === "failed")
    return Astro.redirect(`/signin?next=${encodeURIComponent(next)}&failed`, 303);

  // `__Host-` on https: see learnCookieName.
  Astro.cookies.set(learnCookieName(Astro.url), result.token, {
    httpOnly: true,
    // Behind a TLS-terminating proxy in production; plain http locally.
    secure: Astro.url.protocol === "https:",
    sameSite: "lax",
    path: "/",
    // No `domain`: the cookie belongs to this host alone.
    expires: new Date(result.expiresAt * 1000),
  });
  return Astro.redirect(next, 303);
}

const next = safeNext(Astro.url.searchParams.get("next"), Astro.url);
const failed = Astro.url.searchParams.has("failed");
const locked = Astro.url.searchParams.has("locked");
---

<Learn title="Sign in · Learn" layout="plain" noindex>
  <main class="page signin-page" id="main">
    <h1>Sign in</h1>
    {
      viewer ? (
        <>
          <p class="lede">You are signed in as {viewer.username}.</p>
          <p>
            <a href={next}>Continue</a>
          </p>
        </>
      ) : (
        <>
          <p class="lede">
            For readers who have been given an account. There is no sign-up.
          </p>
          {locked && (
            <p class="form-error" role="alert">
              Too many attempts. Try again later.
            </p>
          )}
          {failed && !locked && (
            <p class="form-error" role="alert">
              Incorrect username or password.
            </p>
          )}
          <form class="signin-form" method="post" action="/signin">
            <input type="hidden" name="next" value={next} />
            <label>
              <span>Username</span>
              <input
                type="text"
                name="username"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                required
                autofocus
                maxlength="64"
              />
            </label>
            <label>
              <span>Password</span>
              <input
                type="password"
                name="password"
                autocomplete="current-password"
                required
                maxlength="1024"
              />
            </label>
            <button type="submit">Sign in</button>
          </form>
        </>
      )
    }
  </main>
</Learn>
