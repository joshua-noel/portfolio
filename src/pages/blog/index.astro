---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { getConfig } from "../../lib/config.ts";
import { formatDate, isoDate } from "../../lib/format.ts";
import { listPublished, summaryOf } from "../../lib/posts.ts";

const { blogUrl } = getConfig();
const posts = listPublished();
---

<Base
  title="Writing · Joshua Noel"
  description="Notes on the things I build, and the problems that made me build them."
  canonical={blogUrl}
>
  <SiteHeader current="writing" />

  <main class="blog-main">
    <h1>Writing</h1>

    {
      posts.length === 0 ? (
        <p class="post-empty">Nothing published yet.</p>
      ) : (
        posts.map((post) => (
          <a class="row" href={`/${post.slug}`}>
            <span class="row-title">{post.title}</span>
            <time class="row-date" datetime={isoDate(post.published_at)}>
              {formatDate(post.published_at)}
            </time>
            <span class="row-sum">{summaryOf(post)}</span>
          </a>
        ))
      )
    }
  </main>
  <SiteFooter />
</Base>
