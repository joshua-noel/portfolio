---
import "katex/dist/katex.min.css";
import initScript from "../scripts/learn-init.js?url";
import "../styles/learn.css";
import LearnNav from "../components/learn/LearnNav.astro";
import LearnTopbar from "../components/learn/LearnTopbar.astro";
import { getConfig } from "../lib/config.ts";
import { getCatalogFor } from "../lib/learn/content.ts";
import type { Depth } from "../lib/learn/depth.ts";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** The course and lecture being read, to mark them in the sidebar. */
  current?: { course: string; lecture?: string };
  /** The depth the server rendered; pages that are not lectures leave it out. */
  depth?: Depth;
  /** Whether the URL asked for a depth; if so, links to other lectures carry it. */
  linkDepth?: Depth;
  /** `reading` has the lecture sidebar; `plain` is a single column. */
  layout?: "reading" | "plain";
  noindex?: boolean;
}

const {
  title,
  description = "University-style lectures on computer science, system design, language models and agents, by Joshua Noel.",
  canonical,
  current,
  depth,
  linkDepth,
  layout = "reading",
  noindex = false,
} = Astro.props;

const { siteUrl } = getConfig();
// The address the reader typed, not the route it was rewritten to (/learn/…).
const here = Astro.locals.here ?? {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
};
const viewer = Astro.locals.viewer;
const catalog = await getCatalogFor(viewer?.role, Astro.locals.allowLocal);
const query = linkDepth ? `?depth=${linkDepth}` : "";
---

<!doctype html>
<html lang="en" data-depth={depth} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <!-- Before first paint, so there is no flash: the theme, and the depth the
         reader last chose when the URL does not name one. A file, because the
         Content-Security-Policy allows no inline script. -->
    <script is:inline src={initScript}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Joshua Noel · Learn" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={current?.lecture ? "article" : "website"} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <LearnTopbar
      catalog={catalog}
      showNav={layout === "reading"}
      viewer={viewer}
      next={here.pathname + here.search}
    />
    {
      catalog.problems.length > 0 && (
        <details class="load-notice" open>
          <summary>
            {catalog.problems.length} problem{catalog.problems.length === 1 ? "" : "s"} in
            the lecture files: what could not be loaded is left out, and everything else is
            still served.
          </summary>
          <pre>{catalog.problems.join("\n\n")}</pre>
        </details>
      )
    }
    <div class:list={["shell", layout === "plain" && "plain"]}>
      {
        layout === "reading" && (
          <LearnNav catalog={catalog} current={current} query={query} />
        )
      }
      <slot />
    </div>
    <div class="scrim" data-scrim hidden></div>
    <footer class="footer">
      <a href={`${siteUrl}/`}>Joshua Noel</a> · Lectures are free to read. Found a mistake?
      <a href={`${siteUrl}/#contact`}>Tell me.</a>
    </footer>
    <script>
      import "../scripts/learn.js";
    </script>
  </body>
</html>
