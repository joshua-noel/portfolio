---
import "katex/dist/katex.min.css";
import initScript from "../scripts/theme-init.js?url";
import transitionsScript from "../scripts/learn-transitions.js?url";
import "../styles/tokens.css";
import "../styles/chrome.css";
import "../styles/learn.css";
import LearnNav from "../components/learn/LearnNav.astro";
import LearnSearch from "../components/learn/LearnSearch.astro";
import LearnAccount from "../components/learn/LearnAccount.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getConfig } from "../lib/config.ts";
import { configuredThemeCookieDomain } from "../lib/theme-cookie.ts";
import { getCatalogFor } from "../lib/learn/content.ts";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** The course and lecture being read, to mark them in the sidebar. */
  current?: { course: string; lecture?: string };
  /** `reading` has the lecture sidebar; `plain` is a single column. */
  layout?: "reading" | "plain";
  noindex?: boolean;
  /** The course's alert hue (c1 to c6): the stylesheet draws it as the rose, on this course's pages only. */
  alert?: string;
}

const {
  title,
  description = "University-style lectures on computer science, system design, language models and agents, by Joshua Noel.",
  canonical,
  current,
  layout = "reading",
  noindex = false,
  alert,
} = Astro.props;

const { siteUrl, blogUrl, learnStealth } = getConfig();
// A stealth release: not indexed, followed or archived, and no preview card for a pasted link.
const stealth = learnStealth !== "off";
// The address the reader typed, not the route it was rewritten to (/learn/…).
const here = Astro.locals.here ?? {
  pathname: Astro.url.pathname,
  search: Astro.url.search,
};
const viewer = Astro.locals.viewer;
const catalog = await getCatalogFor(viewer?.role, Astro.locals.allowLocal);
---

<!doctype html>
<html lang="en" data-alert={alert} data-theme="dark" data-theme-domain={configuredThemeCookieDomain()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <!-- Before first paint, so there is no flash: the theme. A file, because the
         Content-Security-Policy allows no inline script. -->
    <script is:inline src={initScript}></script>
    <!-- Names the direction of a page transition before first paint (see learn.css). -->
    <script is:inline src={transitionsScript}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {stealth ? <meta name="robots" content="noindex, nofollow, noarchive" /> : noindex && <meta name="robots" content="noindex" />}
    {!stealth && <meta property="og:site_name" content="Joshua Noel · Learn" />}
    {!stealth && <meta property="og:title" content={title} />}
    {!stealth && <meta property="og:description" content={description} />}
    {!stealth && <meta property="og:type" content={current?.lecture ? "article" : "website"} />}
    {!stealth && canonical && <meta property="og:url" content={canonical} />}
    {!stealth && <meta name="twitter:card" content="summary" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <SiteHeader site="learn" showNav={layout === "reading"}>
      <LearnSearch />
      <LearnAccount slot="end" viewer={viewer} next={here.pathname + here.search} />
    </SiteHeader>
    {
      /* For an admin: a number and nothing else. What went wrong is in the
         server log, because it quotes files that may be `local` and gives
         server paths. The dev server on the owner's own machine adds detail. */
      catalog.problemCount > 0 && (
        <p class="load-notice" role="status">
          {catalog.problemCount} {catalog.problemCount === 1 ? "file was" : "files were"} left
          out; see the server log.
        </p>
      )
    }
    {
      catalog.problems.length > 0 && (
        <details class="load-notice" open>
          <summary>Detail, shown on your own machine only</summary>
          <pre>{catalog.problems.join("\n\n")}</pre>
        </details>
      )
    }
    <div class:list={["shell", layout === "plain" && "plain"]}>
      {
        layout === "reading" && (
          <LearnNav catalog={catalog} current={current} />
        )
      }
      <slot />
    </div>
    <div class="scrim" data-scrim hidden></div>
    <SiteFooter>
      <a href={`${siteUrl}/`}>Joshua Noel</a> · <a href={`${blogUrl}/`}>Writing</a> · Lectures are free
      to read. Found a mistake? <a href={`${siteUrl}/#contact`}>Tell me.</a>
      <slot name="credit" />
    </SiteFooter>
    <script>
      import "../scripts/theme.js";
      import "../scripts/learn.js";
    </script>
  </body>
</html>
