---
import initScript from "../scripts/theme-init.js?url";
import "../styles/tokens.css";
import "../styles/chrome.css";
import "../styles/global.css";
import "../styles/blog.css";
import { getConfig } from "../lib/config.ts";
import { configuredThemeCookieDomain } from "../lib/theme-cookie.ts";

const { blogUrl } = getConfig();

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Joshua Noel, a software engineer in Trinidad and Tobago. I build software.",
  canonical,
  image,
  type = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-domain={configuredThemeCookieDomain()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <!-- Runs before first paint, as on Learn: the theme the reader chose, and the
         `js` class (.reveal content is only hidden when JS is there to reveal it). -->
    <script is:inline src={initScript}></script>
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Joshua Noel · Writing"
      href={`${blogUrl}/rss.xml`}
    />

    <meta property="og:site_name" content="Joshua Noel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
  </head>
  <body class="public">
    <a class="skip" href="#main">Skip to the content</a>
    <slot />
    <script>
      import "../scripts/theme.js";
      import "../scripts/reveal.js";
    </script>
  </body>
</html>
