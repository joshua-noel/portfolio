---
// The two faces of a book: its spine and its front cover. One component for
// the landing page and for the design page (src/lab/books.astro), so a book
// is drawn in one place. The spine is a few boxes of real text; the cover is
// ONE image (src/lib/learn/cover-image.ts, served by src/pages/learn/covers), the
// course's own `cover.svg` inside the series' layout, so the browser rasterises it once. Sizes are
// fractions of the book's height (`--H`), so a book is the same object at any size.
import Lock from "./Lock.astro";
import type { Book } from "../../lib/learn/bookshelf.ts";

interface Props {
  book: Book;
}

const { book } = Astro.props;
const lectures = `${book.lectures.length} lecture${book.lectures.length === 1 ? "" : "s"}`;
---

<span class="face spine">
  <i class="s-band">{book.number}</i>
  <span class="s-title" data-cols={book.spine.lines}>{book.main}</span>
  {book.locked && <Lock />}
  <span class="s-foot">{lectures}</span>
</span>
<span class="face cover" data-cover={`/covers/${book.slug}.svg`} style={`background-image:url(/covers/${book.slug}.svg)`}></span>
