---
// The bar across the top of every learn page. Links to other hosts are
// absolute: the same markup is served from whichever host asked for it.
import { getConfig } from "../../lib/config.ts";
import type { Catalog } from "../../lib/learn/catalog.ts";

interface Props {
  catalog: Catalog;
  /** Whether there is a sidebar for the menu button to open. */
  showNav: boolean;
}

const { catalog, showNav } = Astro.props;
const { siteUrl, blogUrl } = getConfig();
---

<header class="topbar">
  {
    showNav && (
      <button
        class="icon-button nav-toggle"
        type="button"
        aria-label="Contents"
        aria-controls="sidenav"
        aria-expanded="false"
        data-nav-toggle
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    )
  }
  <span class="brand">
    <a class="site" href={`${siteUrl}/`}>Joshua Noel</a>
    <span class="slash" aria-hidden="true">/</span>
    <a class="home" href="/">Learn</a>
  </span>

  <nav class="parts-nav" aria-label="Shelves">
    {catalog.shelves.map((shelf) => <a href={`/#shelf-${shelf.id}`}>{shelf.title}</a>)}
  </nav>

  <span class="spacer"></span>

  <form class="search" action="/search" method="get" role="search">
    <svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      type="search"
      name="q"
      placeholder="Search"
      autocomplete="off"
      aria-label="Search lectures"
      aria-controls="search-results"
      data-search
    />
    <kbd aria-hidden="true">/</kbd>
    <ul
      class="search-results"
      id="search-results"
      role="listbox"
      aria-label="Search results"
      hidden
    >
    </ul>
  </form>

  <button
    class="icon-button theme-toggle"
    type="button"
    aria-label="Switch theme"
    data-theme-toggle
  >
    <svg
      class="moon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
    <svg
      class="sun"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      ></path>
    </svg>
  </button>
  <!-- Until readers have accounts this is the admin's own login, kept quiet. -->
  <a class="signin" href={`${blogUrl}/admin/login`}>Sign in</a>
</header>
