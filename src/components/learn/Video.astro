---
// Shown when a lecture has video: true and its files are there. They sit
// beside the lecture in the content folder and are served by
// src/pages/learn/media/, with range requests so the player can seek.
import type { Lecture } from "../../lib/learn/lecture.ts";

interface Props {
  lecture: Lecture;
}

const { lecture } = Astro.props;
// By slug, never by the file's `NN-` number: after a `local` lecture is left
// out the page says "Lecture 4" while the file says 05, and the number in a URL
// would show that one is missing. The media route maps the slug to the file.
const base = `/media/${lecture.course}`;
const stem = lecture.slug;
const posterExt = lecture.media.poster?.split(".").pop();
---

<figure class="video">
  <video controls preload="metadata" playsinline poster={posterExt && `${base}/${stem}.poster.${posterExt}`}>
    <source src={`${base}/${stem}.mp4`} type="video/mp4" />
    <track
      kind="captions"
      src={`${base}/${stem}.vtt`}
      srclang="en"
      label="English"
      default
    />
    <p>
      Your browser cannot play this video. <a href={`${base}/${stem}.mp4`}
        >Download it</a
      >.
    </p>
  </video>
  <figcaption>Video: {lecture.front.title}</figcaption>
</figure>
