{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node ./bin/check-learn.mjs && astro build",
    "start": "node ./bin/serve.mjs",
    "check": "node ./bin/check-learn.mjs && astro check",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "learn:dev": "node ./bin/learn-dev.mjs",
    "learn:check": "node ./bin/check-learn.mjs"
  },
  "bin": {
    "portfolio-hash-password": "./bin/hash-password.mjs",
    "portfolio-user": "./bin/user.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/rss": "^4.0.19",
    "@shikijs/rehype": "^4.4.3",
    "astro": "^7.2.4",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.4",
    "parse5": "7.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@milkdown/crepe": "^7.22.1",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}
